<mvc:View
    controllerName="zlogpage.controller.ForgotPassword"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true"
>
    <Page
        showHeader="false"
        backgroundDesign="Transparent"
        class="forgotPasswordPage"
    >
        <FlexBox
            height="auto"
            width="100%"
            justifyContent="Center"
            alignItems="Center"
            direction="Column"
            backgroundDesign="Transparent"
            class="loginPageBackground"
        >
            <HBox class="loginCardBox">
                <VBox width="100%">
                    <!-- LOGO + TITLE BLOCK -->
                    <VBox
                        alignItems="Center"
                        justifyContent="Center"
                        class="sapUiMediumMarginTop sapUiSmallMarginBottom"
                    >
                        <Image
                            id="logoImage"
                            width="160px"
                            densityAware="false"
                            decorative="false"
                            alt="Romsons"
                        />
                        <Title
                            text="Forgot Password"
                            level="H3"
                            titleStyle="H5"
                            class="sapUiSmallMarginTop"
                        />
                    </VBox>

                    <!-- FORM -->
                    <f:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false"
                        class="sapUiTinyMarginTop"
                    >
                        <f:content>
                            <Label
                                text="Email"
                                required="true"
                                labelFor="emailInput"
                                design="Bold"
                            />
                            <HBox
                                width="100%"
                                alignItems="Center"
                            >
                                <Input
                                    id="emailInput"
                                    type="Email"
                                    placeholder="Enter email to get OTP"
                                    width="100%"
                                />
                                <Button
                                    text="Send OTP"
                                    press="onGenerateOTPPress"
                                    type="Emphasized"
                                    class="sapUiTinyMarginBegin"
                                />
                            </HBox>

                            <Label
                                text="OTP"
                                required="true"
                                labelFor="otpInput"
                                design="Bold"
                            />
                            <Input
                                id="otpInput"
                                placeholder="Enter OTP"
                            />

                            <Label
                                text="New Password"
                                required="true"
                                labelFor="newPassword"
                                design="Bold"
                            />
                            <HBox
                                alignItems="Center"
                                width="100%"
                                class="passwordInputBox"
                            >
                                <Input
                                    id="newPassword"
                                    type="Password"
                                    placeholder="Enter new password"
                                    valueState="None"
                                    valueStateText="Password cannot be empty"
                                    liveChange="onPasswordLiveChange"
                                    width="100%"
                                />
                                <core:Icon
                                    id="newPasswordToggleIcon"
                                    src="sap-icon://show"
                                    press="onToggleNewPassword"
                                    tooltip="Show password"
                                    class="passwordToggleIcon"
                                />
                            </HBox>

                            <Label
                                text="Confirm Password"
                                required="true"
                                labelFor="confirmPassword"
                                design="Bold"
                            />
                            <HBox
                                alignItems="Center"
                                width="100%"
                                class="passwordInputBox"
                            >
                                <Input
                                    id="confirmPassword"
                                    type="Password"
                                    placeholder="Confirm password"
                                    valueState="None"
                                    valueStateText="Passwords do not match"
                                    liveChange="onConfirmPasswordLiveChange"
                                    width="100%"
                                />
                                <core:Icon
                                    id="confirmPasswordToggleIcon"
                                    src="sap-icon://show"
                                    press="onToggleConfirmPassword"
                                    tooltip="Show password"
                                    class="passwordToggleIcon"
                                />
                            </HBox>
                        </f:content>
                    </f:SimpleForm>

                    <!-- SUBMIT BUTTON -->
                    <Button
                        text="Submit"
                        type="Emphasized"
                        width="100%"

                        press="onSubmitPress"
                        class="sapUiSmallMarginTop sapUiSmallMarginBottom"
                    />

                    <!-- BACK TO LOGIN -->
                    <HBox
                        justifyContent="Center"
                        width="100%"
                    >
                        <Link
                            text="Back to Sign In"
                            press="onNavBack"
                        />
                    </HBox>
                </VBox>
            </HBox>
        </FlexBox>
    </Page>
</mvc:View>
