<mvc:View
    controllerName="stockreport.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
>
    <f:DynamicPage
        id="dynamicPage"
        fitContent="false"
        toggleHeaderOnTitleClick="true"
        busyIndicatorDelay="0"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <HBox alignItems="Center">
                        <Image
                            id="logoImage"
                            height="36px"
                            class="sapUiSmallMarginEnd logoRounded"
                        />
                        <Title text="Stock Report" />
                    </HBox>
                </f:heading>
                <f:actions>
                    <ObjectStatus
                        icon="sap-icon://employee"
                        title="EMP ID"
                        text="{appModel>/employeeId}"
                        state="Indication20"
                        inverted="true"
                        class="sapUiSmallMarginEnd"
                    />
                    <ObjectStatus
                        icon="sap-icon://factory"
                        title="PLANT"
                        text="{appModel>/plant}"
                        state="Indication20"
                        inverted="true"
                        class="sapUiSmallMarginEnd"
                    />
                    <Button
                        icon="sap-icon://log"
                        text="Logout"
                        type="Negative"
                        press="onLogout"
                    />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox width="100%" alignItems="End" wrap="Wrap">
                    <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0" minWidth="10rem" />
                        </layoutData>
                        <Label text="Plant" required="true" />
                        <Input
                            width="100%"
                            showValueHelp="true"
                            liveChange=".onCriteriaChange"
                            valueHelpRequest=".onValueHelp"
                        >
                            <customData>
                                <core:CustomData key="field" value="plant" />
                            </customData>
                        </Input>
                    </VBox>
                    <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0" minWidth="10rem" />
                        </layoutData>
                        <Label text="MRP Controller" required="true" />
                        <Input
                            width="100%"
                            showValueHelp="true"
                            liveChange=".onCriteriaChange"
                            valueHelpRequest=".onValueHelp"
                        >
                            <customData>
                                <core:CustomData key="field" value="mrpController" />
                            </customData>
                        </Input>
                    </VBox>
                    <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0" minWidth="10rem" />
                        </layoutData>
                        <Label text="Material Code" required="false" />
                        <Input
                            width="100%"
                            showValueHelp="true"
                            liveChange=".onCriteriaChange"
                            valueHelpRequest=".onValueHelp"
                        >
                            <customData>
                                <core:CustomData key="field" value="material" />
                            </customData>
                        </Input>
                    </VBox>
                    <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0" minWidth="10rem" />
                        </layoutData>
                        <Label text="Material Type" required="false" />
                        <Input
                            width="100%"
                            showValueHelp="true"
                            liveChange=".onCriteriaChange"
                            valueHelpRequest=".onValueHelp"
                        >
                            <customData>
                                <core:CustomData key="field" value="materialType" />
                            </customData>
                        </Input>
                    </VBox>
                    <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0" minWidth="10rem" />
                        </layoutData>
                        <Label text="House ID" required="false" />
                        <Input
                            width="100%"
                            showValueHelp="true"
                            liveChange=".onCriteriaChange"
                            valueHelpRequest=".onValueHelp"
                        >
                            <customData>
                                <core:CustomData key="field" value="house" />
                            </customData>
                        </Input>
                    </VBox>
                    <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0" minWidth="10rem" />
                        </layoutData>
                        <Label text="Department" required="false" />
                        <Input
                            width="100%"
                            showValueHelp="true"
                            liveChange=".onCriteriaChange"
                            valueHelpRequest=".onValueHelp"
                        >
                            <customData>
                                <core:CustomData key="field" value="department" />
                            </customData>
                        </Input>
                    </VBox>
                    <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0" minWidth="10rem" />
                        </layoutData>
                        <Label text="Family" required="false" />
                        <Input
                            width="100%"
                            showValueHelp="true"
                            liveChange=".onCriteriaChange"
                            valueHelpRequest=".onValueHelp"
                        >
                            <customData>
                                <core:CustomData key="field" value="family" />
                            </customData>
                        </Input>
                    </VBox>
                    <Button
                        text="Find"
                        icon="sap-icon://search"
                        type="Emphasized"
                        class="sapUiTinyMarginBottom"
                        press=".onFind"
                    />
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox
                visible="{stockModel>/hasResults}"
                class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop sapUiSmallMarginBottom"
            >
                <MessageStrip
                    text="{stockModel>/appliedCriteria}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />
                <HBox justifyContent="End" class="sapUiTinyMarginBottom">
                    <Button
                        text="Export to Excel"
                        icon="sap-icon://excel-attachment"
                        type="Emphasized"
                        press=".onExportExcel"
                    />
                </HBox>
                <table:Table
                    id="stockTable"
                    selectionMode="None"
                    visibleRowCountMode="Fixed"
                    rowCount="15"
                    enableColumnReordering="false"
                    noData="No stock found for the selected criteria."
                    class="materialTable"
                />
                <HBox justifyContent="Center" class="sapUiSmallMarginTop">
                    <Button
                        text="Load More"
                        icon="sap-icon://navigation-down-arrow"
                        visible="{stockModel>/hasMore}"
                        press=".onLoadMore"
                    />
                </HBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
