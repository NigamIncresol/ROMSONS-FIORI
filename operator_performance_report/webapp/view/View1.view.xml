<mvc:View
    controllerName="operatorperformancereport.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
>
    <f:DynamicPage
        id="dynamicPage"
        fitContent="false"
        toggleHeaderOnTitleClick="true"
        busyIndicatorDelay="0"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <HBox alignItems="Center">
                        <Image
                            id="logoImage"
                            height="36px"
                            class="sapUiSmallMarginEnd logoRounded"
                        />
                        <Title text="Operator Performance Report" />
                    </HBox>
                </f:heading>
                <f:actions>
                    <ObjectStatus
                        icon="sap-icon://employee"
                        title="EMP ID"
                        text="{appModel>/employeeId}"
                        state="Indication20"
                        inverted="true"
                        class="sapUiSmallMarginEnd"
                    />
                    <ObjectStatus
                        icon="sap-icon://factory"
                        title="PLANT"
                        text="{appModel>/plant}"
                        state="Indication20"
                        inverted="true"
                        class="sapUiSmallMarginEnd"
                    />
                    <Button
                        icon="sap-icon://log"
                        text="Logout"
                        type="Negative"
                        press="onLogout"
                    />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox width="100%" alignItems="End">
                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
                        <Label text="Plant" required="true" />
                        <Input id="inPlant" width="100%" showValueHelp="true"
                            liveChange=".onCriteriaChange" valueHelpRequest=".onValueHelp">
                            <customData><core:CustomData key="field" value="plant" /></customData>
                        </Input>
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
                        <Label text="Shift Date Range" />
                        <DateRangeSelection id="inRange" width="100%"
                            valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"
                            change=".onDateRangeChange" />
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
                        <Label text="Order" required="true" />
                        <Input id="inOrder" width="100%" showValueHelp="true"
                            liveChange=".onCriteriaChange" valueHelpRequest=".onValueHelp">
                            <customData><core:CustomData key="field" value="order" /></customData>
                        </Input>
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
                        <Label text="House ID" />
                        <Input id="inHouse" width="100%" showValueHelp="true"
                            liveChange=".onCriteriaChange" valueHelpRequest=".onValueHelp">
                            <customData><core:CustomData key="field" value="house" /></customData>
                        </Input>
                    </VBox>
                    <HBox class="sapUiTinyMarginBottom">
                        <Button text="Find" icon="sap-icon://search" type="Emphasized"
                            press=".onFind" class="sapUiTinyMarginEnd" />
                    </HBox>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox
                visible="{perfModel>/hasResults}"
                class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop sapUiSmallMarginBottom"
            >
                <MessageStrip
                    text="{perfModel>/appliedCriteria}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />
                <HBox justifyContent="End" class="sapUiTinyMarginBottom">
                    <Button
                        icon="sap-icon://excel-attachment"
                        text="Export as Excel"
                        type="Emphasized"
                        press=".onExport"
                    />
                </HBox>
                <t:Table
                    id="perfTable"
                    rows="{perfModel>/items}"
                    selectionMode="None"
                    alternateRowColors="true"
                    enableColumnReordering="true"
                    noData="No data found for the selected criteria."
                    class="materialTable"
                >
                    <t:rowMode>
                        <rm:Fixed rowCount="15" />
                    </t:rowMode>
                </t:Table>
                <HBox justifyContent="Center" class="sapUiSmallMarginTop">
                    <Button
                        text="Load More"
                        icon="sap-icon://navigation-down-arrow"
                        visible="{perfModel>/hasMore}"
                        press=".onLoadMore"
                    />
                </HBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
