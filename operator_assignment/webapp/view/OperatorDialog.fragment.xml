<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <SelectDialog
        title="Select Operators"
        multiSelect="true"
        confirmButtonText="Add"
        rememberSelections="false"
        items="{viewModel>/availableOperators}"
        confirm=".onOperatorSelect"
        search=".onSearchOperator"
        liveChange=".onSearchOperator"
        contentWidth="382px"
        contentHeight="500px"
        growing="false"
    >
        <items>
            <CustomListItem
                type="Active"
                class="oaOpListItem"
            >
                <VBox class="oaOpListItemInner">
                    <HBox
                        alignItems="Center"
                        wrap="Wrap"
                    >
                        <Text
                            text="{viewModel>name}"
                            class="oaOpListName sapUiTinyMarginEnd"
                        />
                        <Text
                            text="{viewModel>id}"
                            class="oaOpListId sapUiTinyMarginEnd"
                        />
                        <Text
                            text="{viewModel>designation}"
                            class="oaOpListDesig"
                        />
                    </HBox>
                    <Text
                        text="{= 'Free: ' + ${viewModel>freeHours} + '  |  Assigned: ' + ${viewModel>assignedHours} + '  |  Shift: ' + ${viewModel>totalShiftHours} }"
                        class="oaOpListHours"
                    />
                </VBox>
            </CustomListItem>
        </items>
    </SelectDialog>
</core:FragmentDefinition>
