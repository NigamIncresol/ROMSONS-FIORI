<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        title="Scanned Bags"
        contentWidth="42rem"
        resizable="true"
        draggable="true"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <HBox class="sapUiSmallMarginBottom">
                    <ObjectStatus title="Item" text="{materialsModel>reservationItemNo}" class="sapUiMediumMarginEnd" />
                    <ObjectStatus title="Material" text="{materialsModel>material}" class="sapUiMediumMarginEnd" />
                    <ObjectStatus title="Batch" text="{materialsModel>batchNo}" />
                </HBox>
                <Table
                    items="{materialsModel>bags}"
                    alternateRowColors="true"
                    class="materialTable"
                    noDataText="No bags scanned for this batch yet."
                >
                    <columns>
                        <Column width="3rem"><Text text="#" /></Column>
                        <Column><Text text="Bag QR No" /></Column>
                        <Column hAlign="End"><Text text="Qty" /></Column>
                        <Column width="4rem"><Text text="UoM" /></Column>
                        <Column width="5rem"><Text text="Status" /></Column>
                        <Column width="3rem" />
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{materialsModel>seq}" />
                                <Text text="{materialsModel>qrNo}" />
                                <ObjectNumber number="{path: 'materialsModel>qty', formatter: '.formatQty'}" state="Success" />
                                <Text text="{materialsModel>unit}" />
                                <Text text="{materialsModel>status}" />
                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="Remove bag"
                                    press=".onDeleteBag"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <beginButton>
            <Button text="Close" press=".onCloseBagsDialog" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
